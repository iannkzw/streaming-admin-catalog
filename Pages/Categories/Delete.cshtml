@page
@model StreamingAdminCatalog.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Excluir Categoria";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index">Categorias</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Excluir</li>
                </ol>
            </nav>

            <h1 class="display-6 mb-4 text-danger">@ViewData["Title"]</h1>

            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Atenção!</strong> Você está prestes a excluir a categoria abaixo. Esta ação não pode ser desfeita.
            </div>

            <div class="card border-danger">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.Category.Name</h4>
                    @if (Model.Category.IsActive)
                    {
                        <span class="badge bg-light text-dark fs-6">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Inativo</span>
                    }
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Descrição</label>
                            <p class="form-control-plaintext">
                                @if (!string.IsNullOrEmpty(Model.Category.Description))
                                {
                                    @Model.Category.Description
                                }
                                else
                                {
                                    <em class="text-muted">Sem descrição</em>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Criado em</label>
                            <p class="form-control-plaintext">@Model.Category.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Última atualização</label>
                            <p class="form-control-plaintext">@Model.Category.UpdatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        </div>
                    </div>

                    <form method="post" class="mt-4">
                        <input type="hidden" asp-for="Category.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Confirmar Exclusão
                            </button>
                            <a asp-page="Details" asp-route-id="@Model.Category.Id" class="btn btn-outline-info">
                                <i class="fas fa-eye"></i> Ver Detalhes
                            </a>
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-header bg-warning">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Importante
                    </h5>
                </div>
                <div class="card-body">
                    <p>Ao excluir esta categoria:</p>
                    <ul>
                        <li>A categoria será marcada como inativa</li>
                        <li>Ela não aparecerá mais na listagem principal</li>
                        <li>Esta ação não pode ser desfeita</li>
                    </ul>
                    <p class="text-muted small">
                        <strong>Nota:</strong> A categoria será desativada em vez de ser permanentemente removida do sistema.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}